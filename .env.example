# Matches the docker-compose service. Port 5433 keeps it clear of a Postgres
# you may already have running on 5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/clipping_marketplace"

# HMAC key for the signed session cookie. Any non-empty string works locally.
SESSION_SECRET="dev-secret-change-me"

# production connection string, pasted locally, never committed
# DATABASE_URL for a deployed database can live in .env.production.local and be
# used with: ENV_FILE=.env.production.local pnpm db:migrate
